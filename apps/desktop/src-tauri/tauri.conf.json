{
  "$schema": "https://v2.tauri.app/schemas/tauri.config.json",
  "productName": "OpenDirector",
  "identifier": "com.opendirector.app",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "pnpm --filter @opendirector/desktop bundle:gstreamer && pnpm --filter @opendirector/desktop build",
    "beforeDevCommand": "pnpm --filter @opendirector/desktop dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "gstreamer-runtime/": "gstreamer-runtime/",
      "gstreamer-runtime-root/": ""
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
